# 马拉松训练计划 Agent 配置模板
# ==============================
# 使用方法：复制本文件为 .env，填入你自己的真实值
#   Windows PowerShell: Copy-Item .env.example .env
#   然后 .env 文件不会被 git 提交（已在 .gitignore 中忽略）

# ===== DeepSeek API =====
# 在 https://platform.deepseek.com 申请（新用户有免费额度）
DEEPSEEK_API_KEY=sk-你的密钥

# ===== 数据目录（可选）=====
# 运动文件（GPX/TCX/FIT）与 manual_input.json 所在目录，默认为项目下 data/
# DATA_DIR=data

# ===== 训练目标（可选）=====
# 目标完赛时间，格式 HH:MM:SS，如 06:00:00 表示 6 小时
# 也可在 data/manual_input.json 的"目标"中覆盖此设置
TARGET_FINISH_TIME=06:00:00

# ===== Flask 会话密钥（生产必填）=====
# 用于会话签名与教练长期记忆持久化。务必设为随机长字符串，
# 否则每次容器重启都会丢失用户会话/记忆。生成：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机长字符串
